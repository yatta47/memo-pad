# Copy to .env and adjust.  Never commit .env.
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-please
# Host bind address and ports (0.0.0.0 = reachable from other machines on the network)
BIND_HOST=0.0.0.0
FRONTEND_PORT=3000
BACKEND_PORT=8000
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# Neo4j memory (keep small for laptops)
NEO4J_HEAP=512m
NEO4J_PAGECACHE=256m
# Optional: enables LLM explanation in Design Review (US-07). Everything else works without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LOG_LEVEL=INFO
